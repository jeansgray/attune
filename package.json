{
  "name": "attune",
  "private": true,
  "version": "0.1.0",
  "description": "Attune — dating for neurodivergent adults, matched on social wants and needs",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "turbo run dev --filter=@attune/api",
    "dev:web": "turbo run dev --filter=@attune/web",
    "dev:mobile": "turbo run dev --filter=@attune/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @attune/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @attune/api exec prisma db seed",
    "db:studio": "pnpm --filter @attune/api exec prisma studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
